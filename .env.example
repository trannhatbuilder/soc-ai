# ══════════════════════════════════════════════════════════════════════
#  SOC-AI — Environment Configuration
#  LLM provider: RevidAPI (https://revidapi.com) — thay thế Groq
# ══════════════════════════════════════════════════════════════════════

# ── LLM Provider — RevidAPI (https://revidapi.com) ───────────────────
# RevidAPI tương thích OpenAI. Dùng provider "custom" để analyzer đọc
# các biến LLM_API_KEY / LLM_BASE_URL / LLM_MODEL bên dưới (không cần
# sửa code). Endpoint sẽ được gọi: https://revidapi.com/v1/chat/completions
LLM_PROVIDER=custom
LLM_API_KEY=your_revidapi_api_key_here
LLM_BASE_URL=https://revidapi.com/v1
LLM_MODEL=claude-sonnet-5-5

# ── AbuseIPDB Enrichment ─────────────────────────────────────────────
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2/check
ABUSEIPDB_MAX_AGE_DAYS=90

# ── Telegram Notification ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<API KEY>
TELEGRAM_CHAT_ID=<chat_id>
TELEGRAM_BASE_URL=https://api.telegram.org
TELEGRAM_SEND_DELAY=0.5
TELEGRAM_TIMEOUT=15
TELEGRAM_DRY_RUN=false